# =============================================================================
# Synology RAG Retrieval Platform - example environment configuration
# =============================================================================
# Copy to `.env` and fill in values discovered during Phase 0 (see
# docs/discovery-report.md). This file contains NAMES ONLY - never commit real
# secrets. `.env` is git-ignored.
#
# All values here are loaded into a validated, typed settings object at startup
# (src/synology_rag/config.py). Startup FAILS CLOSED on missing/invalid values.
# =============================================================================

# --- Application ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Bind to localhost by default. A non-local host requires
# ALLOW_NON_LOCAL_BIND=true as an explicit acknowledgement.
BIND_HOST=127.0.0.1
BIND_PORT=8765
ALLOW_NON_LOCAL_BIND=false
# API key for the local REST API. If set, the X-API-Key header is required.
# Leave blank ONLY for pure-localhost development.
LOCAL_API_KEY=
ENABLE_REST_API=true
ENABLE_MCP=true
# Source-file reads are disabled by default (Phase 1 uses indexed text only).
ENABLE_SOURCE_FILE_READ=false
# DANGER: logs full query text and passage text. Development only.
LOG_CONTENT=false

# --- Qdrant (read-only) --------------------------------------------------------
QDRANT_URL=http://synology.local:6333
QDRANT_API_KEY=
# Comma-separated allowlist. Only these collections are ever queried.
QDRANT_ALLOWED_COLLECTIONS=documents
QDRANT_TIMEOUT_SECONDS=5
QDRANT_PREFER_GRPC=false
# Rescore with full-precision vectors on int8-quantized collections (improves
# accuracy; harmless when the collection is not quantized).
QDRANT_RESCORE=true

# --- PostgreSQL (read-only enrichment; optional) -------------------------------
# Set POSTGRES_ENABLED=false if Qdrant payloads already contain all citation
# metadata (confirm in discovery).
POSTGRES_ENABLED=false
POSTGRES_HOST=synology.local
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=rag_retrieval_reader
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=prefer
POSTGRES_STATEMENT_TIMEOUT_MS=3000
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_MIN=0
POSTGRES_POOL_MAX=4

# --- Embeddings (MUST match the indexing pipeline exactly) ---------------------
# provider: openai_compatible | ollama | fake
#   openai_compatible : OpenAI, Azure OpenAI, LM Studio, Ollama (/v1), vLLM, TEI.
#   ollama            : native Ollama POST /api/embed (use when the indexer embeds
#                       with Ollama, e.g. qwen3-embedding). BASE_URL is the Ollama
#                       host root, e.g. http://192.168.1.10:11434 (no /v1).
#   fake              : deterministic hash embedder for local testing ONLY.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=15
# L2-normalise the query vector before search. Set to match how the index was
# built. Leave false if the indexer does not normalize (Cosine handles magnitude).
EMBEDDING_NORMALISE=false

# --- Retrieval limits / context budget -----------------------------------------
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=25
# Leave blank to disable the default score threshold.
DEFAULT_MINIMUM_SCORE=
MAX_QUERY_LENGTH=4000
DEFAULT_NEIGHBOURS_BEFORE=1
DEFAULT_NEIGHBOURS_AFTER=1
MAX_NEIGHBOURS_BEFORE=2
MAX_NEIGHBOURS_AFTER=2
MAX_TOTAL_CHUNKS=20
MAX_RETURNED_CHARACTERS=40000
# Cap per chunk (0 = no explicit per-chunk cap; use stored chunk length).
MAX_CHARACTERS_PER_CHUNK=0
# Candidate oversampling for dense search (headroom for dedup/threshold):
# candidates = clamp(limit*CANDIDATE_MULTIPLIER, limit, MAX_CANDIDATES).
CANDIDATE_MULTIPLIER=4
MAX_CANDIDATES=100
# Collapse near-duplicate versions of the same document (e.g. "deck v2..v6")
# across results, keeping the most recent (by modified date, else best score).
COLLAPSE_DUPLICATE_VERSIONS=false
DUPLICATE_VERSION_SIMILARITY=0.9

# --- Reliability ---------------------------------------------------------------
SEARCH_TIMEOUT_SECONDS=10
MAX_RETRIES=2
# When multiple collections are searched and one is unavailable: true returns
# partial results with a warning; false (default) fails the whole search.
PARTIAL_RESULTS_ON_COLLECTION_ERROR=false

# --- HTTP hardening ------------------------------------------------------------
# Reject request bodies larger than this many bytes (413).
MAX_REQUEST_BYTES=65536
# Comma-separated CORS origins for a local browser chat app (e.g.
# http://localhost:3000). Empty disables CORS (server-to-server needs none).
CORS_ALLOW_ORIGINS=

# --- Schema mapping ------------------------------------------------------------
# Path to the YAML mapping that translates public field names to the DISCOVERED
# Qdrant payload keys and PostgreSQL columns. This is how the engine adapts to
# your existing index without hardcoded constants. See
# config/schema_mapping.example.yaml and docs/discovery-report.md.
SCHEMA_MAPPING_FILE=config/schema_mapping.yaml

# On startup, verify that allowed collections exist and vector dimensions match
# EMBEDDING_DIMENSIONS. Disable ONLY for offline development.
STARTUP_VERIFY_COLLECTIONS=true
